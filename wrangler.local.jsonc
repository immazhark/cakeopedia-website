{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cakeopedia-local-proof",
  "main": "worker/local.ts",
  "compatibility_date": "2026-07-30",
  "vars": { "LOCAL_DEV": "1" },
  "workers_dev": false,
  "preview_urls": false,
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "cakeopedia-local-uploads" }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "cakeopedia-local-only",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }]
}
