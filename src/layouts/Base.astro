---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/figtree';
import '../styles/global.css';
import { SITE, INSTAGRAM } from '../site';
interface Props { title: string; description: string; current?: string; image?: string; private?: boolean; noindex?: boolean; bakery?: boolean; ld?: object[] }
const { title, description, current, image, private: isPrivate = false, noindex = false, bakery = false, ld = [] } = Astro.props;
const indexable = import.meta.env.PUBLIC_SITE_ENV === 'production' && !isPrivate && !noindex;
const canonical = new URL(Astro.url.pathname, SITE).href;
const abs = image ? new URL(image, SITE).href : undefined;
// Only facts the owner approved: no address, hours, prices, ratings or service area.
const bakeryLd = { '@context': 'https://schema.org', '@type': 'Bakery', '@id': `${SITE}/#bakery`, name: 'Cakeopedia Austin', url: SITE + '/', description, sameAs: [INSTAGRAM], ...(abs ? { image: abs } : {}) };
const nav = isPrivate ? [] : [['/menu/', 'Menu'], ['/creations/', 'Creations'], ['/size-guide/', 'Size guide'], ['/cake-care/', 'Care'], ['/story/', 'Story'], ['/enquiry/', 'Enquire']];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Previews stay out of search; robots.txt and this tag flip only for a production build. -->
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="data:," />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#91ae8f" />
    {indexable && <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content="Cakeopedia Austin" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {indexable && <meta property="og:url" content={canonical} />}
    {abs && <meta property="og:image" content={abs} />}
    <meta name="twitter:card" content={abs ? 'summary_large_image' : 'summary'} />
    {indexable && bakery && <script type="application/ld+json" set:html={JSON.stringify(bakeryLd).replace(/</g, '\u003c')} />}
    {indexable && ld.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item).replace(/</g, '<')} />)}
    <title>{title}</title>
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">Cakeopedia <span>Austin</span></a>
        <nav aria-label="Main">
          <ul class="nav">
            {nav.map(([href, label]) => <li><a href={href} aria-current={current === href ? 'page' : undefined}>{label}</a></li>)}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="wrap">
        <div>
          <p><strong>Cakeopedia Austin</strong> is a small home bakery in Austin, Texas. Cakes shown on this site are previous work, not a menu.</p>
          <p>{!indexable && "Development preview. "}Prices, flavours, sizes and fulfilment details are being confirmed with the baker.</p>
        </div>
        <div>
          <p><a href="https://www.instagram.com/cakeopedia.austin/" rel="noopener">@cakeopedia.austin on Instagram</a></p>
          <p>Online enquiries are not open yet.</p>
        </div>
      </div>
    </footer>
    <script>
      // Reveal-on-scroll (content is already visible without JS or with reduced motion).
      // A block is revealed once its top edge is above the viewport bottom, so skipped blocks (End key, anchor jumps, fast scrolling)
      // and blocks at the very end of a page can never stay hidden.
      let pending = [...document.querySelectorAll<HTMLElement>('.reveal')];
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) pending.forEach((el) => el.classList.add('in'));
      else {
        let queued = false;
        const sweep = () => {
          queued = false;
          pending = pending.filter((el) => { if (el.getBoundingClientRect().top < innerHeight * 0.92 || scrollY + innerHeight >= document.documentElement.scrollHeight - 2) { el.classList.add('in'); return false; } return true; });
          if (!pending.length) { removeEventListener('scroll', request); removeEventListener('resize', request); }
        };
        const request = () => { if (!queued) { queued = true; requestAnimationFrame(sweep); } };
        addEventListener('scroll', request, { passive: true }); addEventListener('resize', request); addEventListener('load', request);
        sweep();
      }
    </script>
  </body>
</html>
