---
import Base from '../../layouts/Base.astro';
---
<Base title="Owner · Cakeopedia Austin" description="Private owner area." private>
  <div class="wrap admin" id="admin">
    <div class="page-head" style="padding-block:var(--space-4) var(--space-3)">
      <p class="eyebrow">Owner area</p>
      <h1 style="font-size:var(--step-3)">Enquiries &amp; orders</h1>
    </div>
    <div class="tabs" role="group" aria-label="Section">
      <button class="chip" type="button" data-tab="inbox" aria-pressed="true">Enquiries</button>
      <button class="chip" type="button" data-tab="calendar" aria-pressed="false">Calendar</button>
      <button class="chip" type="button" data-tab="menu" aria-pressed="false">Menu</button>
    </div>
    <p id="notice" class="err" role="alert" hidden></p>
    <section id="inbox" aria-label="Enquiries"></section>
    <section id="detail" aria-label="Enquiry" hidden></section>
    <section id="calendar" aria-label="Calendar" hidden></section>
    <section id="menu" aria-label="Menu" hidden></section>
  </div>
  <noscript><p class="wrap">This area needs JavaScript.</p></noscript>
  <script>
    // Phone-first owner screens. All authority lives on the server: this page only calls the authenticated API.
    import { splitPayment } from '../../data/pricing';
    type Json = Record<string, any>;
    const $ = (id: string) => document.getElementById(id)!;
    const money = (c: number) => '$' + (c / 100).toFixed(2);
    function cents(s: string): number | null { const m = /^\s*\$?(\d{1,6})(?:\.(\d{1,2}))?\s*$/.exec(s); return m ? Number(m[1]) * 100 + Number((m[2] ?? '').padEnd(2, '0') || 0) : null; }
    const h = (tag: string, attrs: Record<string, string> = {}, ...kids: (Node | string)[]) => { const e = document.createElement(tag); for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, v); e.append(...kids); return e; };
    const when = (t: number) => new Date(t).toLocaleString('en-US', { timeZone: 'America/Chicago', dateStyle: 'medium', timeStyle: 'short' });
    // Screens are rebuilt from scratch; put keyboard focus back on the same control (by position) so it is not dropped to the page top.
    const FOCUSABLE = 'button,a[href],input,select,textarea';
    const focusIndex = (root: HTMLElement) => root.contains(document.activeElement) ? [...root.querySelectorAll(FOCUSABLE)].indexOf(document.activeElement!) : -1;
    const refocus = (root: HTMLElement, i: number) => { if (i >= 0) (root.querySelectorAll(FOCUSABLE)[i] as HTMLElement | undefined)?.focus(); };
    const notice = (m: string) => { const n = $('notice'); n.hidden = !m; n.textContent = m; };
    async function api(path: string, method = 'GET', body?: object): Promise<{ ok: boolean; status: number; data: Json }> {
      try {
        const r = await fetch(path, { method, headers: { 'X-Cakeopedia-Admin': '1', ...(body ? { 'Content-Type': 'application/json' } : {}) }, ...(body ? { body: JSON.stringify(body) } : {}) });
        const data = r.status === 204 ? {} : await r.json().catch(() => ({}));
        if (r.status === 401) notice('Your sign-in has expired. Please reload the page and sign in again.');
        return { ok: r.ok, status: r.status, data };
      } catch { notice(method === 'GET' ? 'No connection. Please try again.' : 'No connection. We could not confirm whether that was saved. Tap the same button again; it is safe and will not save it twice.'); return { ok: false, status: 0, data: {} }; }
    }
    const field = (label: string, input: HTMLElement, hint?: string) => { const id = 'f' + Math.random().toString(36).slice(2, 8); input.id = id; return h('div', { class: 'field' }, h('label', { for: id }, label), input, ...(hint ? [h('p', { class: 'hint' }, hint)] : [])); };
    const input = (type = 'text', attrs: Record<string, string> = {}) => h('input', { type, ...attrs }) as HTMLInputElement;
    const select = (opts: [string, string][]) => { const s = h('select') as HTMLSelectElement; for (const [v, t] of opts) s.append(h('option', { value: v }, t)); return s; };
    const btn = (text: string, onclick: () => void, cls = 'btn') => { const b = h('button', { type: 'button', class: cls }, text) as HTMLButtonElement; b.addEventListener('click', onclick); return b; };

    // ---- tabs
    const views: Record<string, string> = { inbox: 'inbox', calendar: 'calendar', menu: 'menu' };
    function show(tab: 'inbox' | 'calendar' | 'detail' | 'menu') {
      for (const k of ['inbox', 'detail', 'calendar', 'menu']) $(k).hidden = k !== tab;
      document.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tab === (tab === 'detail' ? 'inbox' : tab))));
      notice('');
    }
    document.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((b) => b.addEventListener('click', () => { const t = views[b.dataset.tab!] as 'inbox' | 'calendar' | 'menu'; show(t); if (t === 'calendar') loadCalendar(); else if (t === 'menu') loadMenu(); else loadInbox(true); }));

    // ---- inbox
    let filter = ''; let items: Json[] = []; let next: Json | null = null;
    async function loadInbox(reset: boolean) {
      if (reset) { items = []; next = null; }
      const q = new URLSearchParams({ limit: '20' }); if (filter) q.set('status', filter);
      if (next) { q.set('beforeAt', String(next.beforeAt)); q.set('beforeId', next.beforeId); }
      const r = await api('/admin/api/enquiries?' + q); if (!r.ok) return;
      items.push(...r.data.items); next = r.data.next; renderInbox();
    }
    function renderInbox() {
      const root = $('inbox'), fi = focusIndex(root); root.replaceChildren();
      const chips = h('div', { class: 'chips', role: 'group', 'aria-label': 'Filter by status' });
      for (const s of ['', 'new', 'replied', 'quoted', 'confirmed', 'closed']) { const c = btn(s || 'All', () => { filter = s; loadInbox(true); }, 'chip'); c.setAttribute('aria-pressed', String(filter === s)); chips.append(c); }
      root.append(chips, addForm());
      const list = h('ul', { class: 'admin-list' });
      for (const it of items) {
        const b = btn('', () => openDetail(it.id), 'row');
        b.append(h('strong', {}, it.name ?? 'Unnamed'), h('span', {}, ` · ${it.occasion ?? 'Occasion not set'}${it.eventDate ? ' · ' + it.eventDate : ''}`), h('span', { class: 'badge' }, it.status), ...(it.pictures ? [h('span', { class: 'hint' }, `${it.pictures} picture${it.pictures > 1 ? 's' : ''}`)] : []));
        list.append(h('li', {}, b));
      }
      if (!items.length) list.append(h('li', { class: 'hint' }, 'No enquiries here yet.'));
      root.append(list); if (next) root.append(btn('Load more', () => loadInbox(false), 'btn btn--ghost'));
      refocus(root, fi);
    }
    function addForm() {
      const d = h('details', { class: 'add' }, h('summary', {}, 'Add an Instagram order'));
      const name = input('text', { maxlength: '100' }), handle = input('text', { maxlength: '31', autocapitalize: 'none' }), date = input('date'), notes = h('textarea', { rows: '3', maxlength: '2000' }) as HTMLTextAreaElement, rid = crypto.randomUUID();
      d.append(field('Customer name', name), field('Instagram handle', handle), field('Date needed (leave blank if undecided)', date), field('What they asked for', notes),
        btn('Add enquiry', async () => {
          const r = await api('/admin/api/enquiries', 'POST', { requestId: rid, name: name.value, contact: { kind: 'instagram', value: handle.value }, dateUndecided: !date.value, eventDate: date.value || null, notes: notes.value || null });
          if (!r.ok) return notice('Please check the name and Instagram handle.'); notice(''); openDetail(r.data.id);
        }));
      return d;
    }

    // ---- detail
    async function openDetail(id: string) {
      const r = await api('/admin/api/enquiries/' + id); if (!r.ok) return; show('detail');
      const e = r.data, p = e.payload as Json, o = e.order as Json, root = $('detail'), fi = focusIndex(root); root.replaceChildren();
      const dl = h('dl', { class: 'facts' });
      const fact = (k: string, v: unknown) => { if (v === null || v === undefined || v === '' || (Array.isArray(v) && !v.length)) return; dl.append(h('dt', {}, k), h('dd', {}, String(v))); };
      fact('Contact', `${p.contact.kind}: ${p.contact.value}`); fact('Occasion', p.occasion); fact('Date', p.eventDate ?? 'Not decided'); fact('People', p.servings); fact('Size', p.size); fact('Flavour', p.flavour);
      fact('Add-ons', (p.addons ?? []).join(', ')); fact('Pickup or delivery', p.fulfilment); fact('Budget', p.budgetCents != null ? money(p.budgetCents) : null); fact('Comments', p.notes); fact('Gallery reference', (p.creationIds ?? []).join(', '));
      fact('Reference', e.reference);
      root.append(btn('← All enquiries', () => { show('inbox'); loadInbox(true); }, 'btn btn--ghost'), h('h2', { style: 'font-size:var(--step-2);margin-top:var(--space-3)' }, p.name, ' ', h('span', { class: 'badge' }, e.status)), dl);
      if (e.pictures.length) { const g = h('div', { class: 'pic-list' }); e.pictures.forEach((pic: Json, i: number) => g.append(h('a', { href: `/admin/api/uploads/${pic.id}`, target: '_blank', rel: 'noopener' }, h('img', { src: `/admin/api/uploads/${pic.id}`, alt: `Inspiration picture ${i + 1}`, width: '120', height: '120', loading: 'lazy' })))); root.append(h('h3', {}, 'Inspiration pictures'), g); }

      // status
      const st = select(['new', 'replied', 'quoted', 'confirmed', 'closed'].filter((s) => s !== e.status).map((s) => [s, s])), note = input('text', { maxlength: '1000' });
      const errs: Record<string, string> = { no_quote: 'Add a quote first.', deposit_not_recorded: 'Record the agreed deposit payment before confirming.', status_changed: 'This enquiry changed elsewhere. Reloaded.' };
      root.append(h('h3', {}, 'Status'), h('div', { class: 'row-form' }, field('Change to', st), field('Note (optional)', note), btn('Update status', async () => {
        const r2 = await api(`/admin/api/enquiries/${id}/status`, 'POST', { status: st.value, expected: e.status, note: note.value || null });
        if (!r2.ok) { notice(errs[r2.data.error] ?? 'Could not update.'); if (r2.status === 409 && r2.data.error === 'status_changed') openDetail(id); return; } openDetail(id);
      })), h('ul', { class: 'hint' }, ...e.events.map((v: Json) => h('li', {}, `${when(v.at)} · ${v.status}${v.note ? ' · ' + v.note : ''}`))));

      // quote
      const q = o.quote as Json | null;
      const total = input('text', { inputmode: 'decimal', value: q ? (q.totalCents / 100).toFixed(2) : '' }), dep = input('text', { inputmode: 'decimal', value: q ? (q.depositCents / 100).toFixed(2) : '' });
      // Suggest the agreed 50% advance; the owner can still overwrite it (e.g. for an approved rush arrangement).
      let depEdited = !!q; dep.addEventListener('input', () => { depEdited = true; });
      total.addEventListener('input', () => { const t = cents(total.value); if (!depEdited && t !== null) dep.value = (splitPayment(t).depositCents / 100).toFixed(2); });
      const ful = select([['pickup', 'Pickup'], ['delivery', 'Delivery']]); if (q) ful.value = q.fulfilment;
      const date = input('date', { value: q?.date ?? '' }), time = input('time', { value: q?.time ?? '' });
      const qrid = crypto.randomUUID(), dn = h('textarea', { rows: '3', maxlength: '2000' }) as HTMLTextAreaElement, pn = h('textarea', { rows: '3', maxlength: '2000' }) as HTMLTextAreaElement; dn.value = q?.designNotes ?? ''; pn.value = q?.prepNotes ?? '';
      root.append(h('h3', {}, q ? `Quote (version ${q.version})` : 'Quote'), h('div', { class: 'form' },
        field('Agreed total ($)', total), field('Deposit ($)', dep), field('Pickup or delivery', ful), field('Date', date), field('Time (optional)', time), field('Agreed design', dn), field('Preparation notes', pn),
        btn(q ? 'Save new quote version' : 'Save quote', async () => {
          const t = cents(total.value), d = cents(dep.value); if (t === null || d === null || d > t || !date.value) return notice('Enter the total, a deposit that is not more than the total, and a date.');
          const r3 = await api(`/admin/api/enquiries/${id}/quote`, 'POST', { requestId: qrid, totalCents: t, depositCents: d, fulfilment: ful.value, date: date.value, time: time.value || null, designNotes: dn.value || null, prepNotes: pn.value || null, expectedVersion: q?.version ?? 0 });
          if (!r3.ok) { notice(r3.status === 0 ? '' : r3.data.error === 'would_unconfirm' ? 'This order is confirmed and the deposit recorded is less than this deposit.' : r3.data.error === 'below_paid' ? 'The total cannot be less than what is already paid.' : r3.status === 409 ? 'This quote changed elsewhere. Reloaded.' : 'Please check the quote details.'); if (r3.status === 409) openDetail(id); return; } openDetail(id);
        })));

      // payments (records only; the owner checks Zelle herself)
      const pay = h('ul', { class: 'admin-list' });
      for (const x of o.payments as Json[]) pay.append(h('li', {}, `${x.kind} ${money(x.amountCents)} received ${x.receivedOn}${x.note ? ' · ' + x.note : ''}`, ...(x.voidedAt ? [h('span', { class: 'badge' }, 'voided: ' + x.voidReason)] : [voidControl(id, x)])));
      const pk = select([['deposit', 'Deposit'], ['balance', 'Balance']]), pa = input('text', { inputmode: 'decimal' }), pd = input('date'), pnote = input('text', { maxlength: '500' }), prid = crypto.randomUUID();
      root.append(h('h3', {}, 'Payments'), h('p', { class: 'hint' }, 'Record a payment only after you have seen it arrive in Zelle. Nothing here checks payments automatically.'),
        h('p', {}, q ? `Paid ${money(o.paidCents)} of ${money(q.totalCents)} · balance ${money(o.balanceCents)}` : 'Add a quote to see the balance.'), pay,
        h('div', { class: 'form' }, field('Type', pk), field('Amount ($)', pa), field('Date received', pd), field('Note (optional)', pnote), btn('Record payment', async () => {
          const a = cents(pa.value); if (a === null || a < 1 || !pd.value) return notice('Enter an amount and the date it arrived.');
          const r5 = await api(`/admin/api/enquiries/${id}/payments`, 'POST', { requestId: prid, kind: pk.value, amountCents: a, receivedOn: pd.value, note: pnote.value || null }); if (r5.ok) openDetail(id); else if (r5.status) notice(r5.data.error === 'exceeds_balance' ? `That is more than the balance (${money(r5.data.balanceCents)}).` : r5.data.error === 'no_quote' ? 'Save a quote first.' : 'Please check the payment details.');
        })));
      refocus(root, Math.max(fi, 0)); // same control after an update; the Back button when first opened
    }

    function voidControl(id: string, x: Json) {
      const wrap = h('span', { class: 'row-form' });
      wrap.append(btn('Void', () => {
        const reason = input('text', { maxlength: '500', 'aria-label': 'Why is this record wrong?', placeholder: 'Why is this record wrong?' });
        wrap.replaceChildren(reason, btn('Confirm void', async () => { if (!reason.value.trim()) return notice('Please say why.'); const r = await api(`/admin/api/enquiries/${id}/payments/${x.id}/void`, 'POST', { reason: reason.value }); if (r.ok) openDetail(id); }, 'chip'));
        reason.focus();
      }, 'chip'));
      return wrap;
    }

    // ---- calendar
    let cursor = new Date(); cursor.setDate(1);
    const iso = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    async function loadCalendar() {
      const first = new Date(cursor.getFullYear(), cursor.getMonth(), 1), last = new Date(cursor.getFullYear(), cursor.getMonth() + 1, 0);
      const r = await api(`/admin/api/calendar?from=${iso(first)}&to=${iso(last)}`); if (!r.ok) return;
      const orders: Json[] = r.data.orders, busy = new Map<string, string>((r.data.busy as Json[]).map((b) => [b.date, b.note ?? '']));
      const root = $('calendar'), fi = focusIndex(root); root.replaceChildren();
      root.append(h('div', { class: 'cal-nav' }, btn('‹', () => { cursor.setMonth(cursor.getMonth() - 1); loadCalendar(); }, 'chip'), h('strong', { 'aria-live': 'polite' }, first.toLocaleString('en-US', { month: 'long', year: 'numeric' })), btn('›', () => { cursor.setMonth(cursor.getMonth() + 1); loadCalendar(); }, 'chip')),
        h('p', { class: 'hint' }, 'Tap a day to mark it busy or free. Confirmed orders show under their date. Busy dates are a note for you; the public site does not show availability.'));
      const list = h('ul', { class: 'admin-list' });
      for (let day = 1; day <= last.getDate(); day++) {
        const d = iso(new Date(cursor.getFullYear(), cursor.getMonth(), day)), isBusy = busy.has(d), todays = orders.filter((o) => o.date === d);
        const b = btn(`${new Date(d + 'T12:00:00').toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' })}${isBusy ? ' · Busy' : ''}`, async () => { const r2 = isBusy ? await api('/admin/api/busy/' + d, 'DELETE') : await api('/admin/api/busy/' + d, 'PUT', {}); if (r2.ok) loadCalendar(); }, 'chip');
        b.setAttribute('aria-pressed', String(isBusy));
        const li = h('li', {}, b); for (const o of todays) li.append(btn(`${o.time ?? ''} ${o.name} (${o.fulfilment})`, () => openDetail(o.id), 'row'));
        list.append(li);
      }
      root.append(list); refocus(root, fi);
    }

    // ---- menu (private drafts; only published + available items can ever reach the public site)
    let menuItems: Json[] = [];
    const slug = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 60);
    async function loadMenu() {
      const r = await api('/admin/api/menu'); if (!r.ok) return; menuItems = r.data.items; renderMenu();
    }
    function renderMenu() {
      const root = $('menu'), hadFocus = root.contains(document.activeElement); root.replaceChildren();
      const heading = h('h2', { tabindex: '-1', style: 'font-size:var(--step-2)' }, 'Menu');
      root.append(heading, h('p', { class: 'hint' }, 'Drafts stay private. An item appears on the public site only after you publish it and mark it available, and the website is next updated.'), btn('Add a menu item', () => editMenu(null), 'btn'));
      const list = h('ul', { class: 'admin-list' });
      for (const it of menuItems) list.append(h('li', {}, btn(`${it.title} · ${it.status}${it.availability === 'unavailable' ? ' · unavailable' : ''}`, () => editMenu(it), 'row')));
      if (!menuItems.length) list.append(h('li', { class: 'hint' }, 'No menu items yet.'));
      root.append(list);
      if (hadFocus) heading.focus(); // keyboard users keep their place after Save or Cancel
    }
    function editMenu(it: Json | null) {
      const root = $('menu'); root.replaceChildren();
      const title = input('text', { maxlength: '100', value: it?.title ?? '' }), category = input('text', { maxlength: '100', value: it?.category ?? '' });
      const kind = select([['custom', 'Custom cake (price is a starting price)'], ['standard', 'Standard item (fixed price)']]); kind.value = it?.kind ?? 'custom';
      const status = select([['draft', 'Draft (private)'], ['published', 'Published'], ['archived', 'Archived']]); status.value = it?.status ?? 'draft';
      const avail = select([['available', 'Available'], ['unavailable', 'Not available right now']]); avail.value = it?.availability ?? 'available';
      const area = (max: string) => h('textarea', { rows: '3', maxlength: max }) as HTMLTextAreaElement;
      const flav = area('2000'), fill = area('2000'), note = area('1000');
      flav.value = (it?.flavours ?? []).join('\n'); fill.value = (it?.fillings ?? []).join('\n'); note.value = it?.ingredientNote ?? '';
      const sizeBox = h('div'), addonBox = h('div');
      const rows = new Map<Element, HTMLInputElement[]>();
      const sizeRow = (s?: Json) => {
        const r = h('div', { class: 'form size-row' });
        const f = [input('text', { maxlength: '100', value: s?.label ?? '' }), input('text', { inputmode: 'numeric', value: s ? String(s.layers) : '2' }), input('text', { inputmode: 'numeric', value: s ? String(s.servings.min) : '' }), input('text', { inputmode: 'numeric', value: s ? String(s.servings.max) : '' }), input('text', { inputmode: 'decimal', value: s ? (s.priceCents / 100).toFixed(2) : '' })];
        r.append(field('Size name (for example 6 inch)', f[0]!), field('Layers', f[1]!), field('Serves from', f[2]!), field('Serves up to', f[3]!), field('Price ($)', f[4]!), btn('Remove this size', () => { rows.delete(r); r.remove(); }, 'chip'));
        rows.set(r, f); return r;
      };
      const addonRow = (a?: Json) => {
        const r = h('div', { class: 'form' });
        const f = [input('text', { maxlength: '100', value: a?.label ?? '' }), input('text', { inputmode: 'decimal', value: a ? (a.priceCents / 100).toFixed(2) : '' })];
        r.append(field('Extra', f[0]!), field('Price ($)', f[1]!), btn('Remove this extra', () => { rows.delete(r); r.remove(); }, 'chip'));
        rows.set(r, f); return r;
      };
      for (const s of it?.sizes ?? []) sizeBox.append(sizeRow(s));
      for (const a of it?.addons ?? []) addonBox.append(addonRow(a));
      const split = (t: string) => t.split('\n').map((x) => x.trim()).filter(Boolean);
      root.append(h('h3', {}, it ? 'Edit menu item' : 'New menu item'), h('div', { class: 'form' },
        field('Name', title), field('Group (for example Birthday, Mini)', category), field('Type', kind), field('Status', status), field('Availability', avail),
        h('h4', {}, 'Sizes and prices'), sizeBox, btn('Add a size', () => sizeBox.append(sizeRow()), 'chip'),
        field('Flavours (one per line)', flav), field('Fillings (one per line)', fill),
        h('h4', {}, 'Extras'), addonBox, btn('Add an extra', () => addonBox.append(addonRow()), 'chip'),
        field('Ingredient note (optional)', note, 'Only what you are sure is true.'),
        btn('Save', async () => {
          const sizes: Json[] = [], addons: Json[] = [];
          for (const r of Array.from(sizeBox.children)) {
            const [n, l, a, b, p] = rows.get(r)!, pc = cents(p!.value);
            if (!n!.value.trim() || !/^\d+$/.test(l!.value) || !/^\d+$/.test(a!.value) || !/^\d+$/.test(b!.value) || pc === null) return notice('Please check the sizes: each needs a name, whole numbers for layers and servings, and a price.');
            sizes.push({ label: n!.value, layers: +l!.value, servings: { min: +a!.value, max: +b!.value }, priceCents: pc });
          }
          for (const r of Array.from(addonBox.children)) {
            const [n, p] = rows.get(r)!, pc = cents(p!.value);
            if (!n!.value.trim() || pc === null) return notice('Each extra needs a name and a price.');
            addons.push({ label: n!.value, priceCents: pc });
          }
          const id = it?.id ?? slug(title.value);
          if (!id) return notice('Please give the item a name.');
          const r = await api(`/admin/api/menu/${id}`, 'PUT', { expectedRevision: it?.revision ?? null, item: { id, title: title.value, category: category.value, status: status.value, availability: avail.value, kind: kind.value, sizes, flavours: split(flav.value), fillings: split(fill.value), addons, ingredientNote: note.value.trim() || null } });
          if (r.ok) { notice(''); loadMenu(); }
          else if (r.status === 409) { notice('This item was changed somewhere else. The latest version has been loaded.'); loadMenu(); }
          else if (r.status) notice('Please check the details. A published item needs a name, a group and at least one size.');
        }), btn('Cancel', () => renderMenu(), 'chip')));
      if (it) { // earlier saved versions; "Use this version" fills the form, and Save writes it as a new revision on top of the current one
        const box = h('details', { class: 'add' }, h('summary', {}, 'Earlier versions')), list = h('ul', { class: 'admin-list' });
        let loaded = false;
        box.addEventListener('toggle', async () => {
          if (!(box as HTMLDetailsElement).open || loaded) return; loaded = true;
          const r = await api(`/admin/api/menu/${it.id}/history`); if (!r.ok) { loaded = false; return; }
          const old = (r.data.versions as Json[]).filter((v) => v.revision !== it.revision);
          for (const v of old) list.append(h('li', {}, btn(`${when(Date.parse(v.updatedAt))} · ${v.title} · ${v.status}${v.sizes.length ? ' · from ' + money(Math.min(...v.sizes.map((x: Json) => x.priceCents))) : ''}`, () => editMenu({ ...v, revision: it.revision }), 'row')));
          if (!old.length) list.append(h('li', { class: 'hint' }, 'No earlier versions yet.'));
        });
        box.append(list); root.append(box);
      }
      ($('menu').querySelector('input') as HTMLElement).focus();
    }
    loadInbox(true);
  </script>
</Base>
