}
.cabinet .card-label h3 {
  font:600 1rem system-ui,sans-serif
}
.cabinet .story {
  background:#f1c6a7;
  padding:3rem;
  margin-block:3rem
}
.cabinet .invitation {
  border-top:0
}

:global(body.table) {
  --paper:#f1efe5;
  --ink:#333d32;
  --accent:#626f43;
  --line:#aeb4a1;
  --soft:#dce0cd
}
.table .hero {
  grid-template-columns:1.15fr 1fr
}
.table .hero-copy {
  order:2
}
.table .hero-art {
  padding:0;
  order:1
}
.table .hero-art .image-slot {
  min-height:30rem
}
.table h1 {
  font-style:italic;
  font-size:clamp(3rem,6vw,5.8rem)
}
.table .hero-art .art-caption {
  transform:none
}
.table .creation-grid {
  grid-template-columns:repeat(2,1fr);
  gap:3rem
}
.table .creation-card:nth-child(even) {
  margin-top:0
}
.table .creation-card .image-slot {
  min-height:23rem
}
.table .story {
  padding-top:5rem
}
.table .invitation {
