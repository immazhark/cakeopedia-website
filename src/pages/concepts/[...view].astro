}

@media(max-width:760px) {
  .notice {
  flex-direction:column;
  gap:.2rem;
  font-size:.6rem
}
header {
  padding-block:1.5rem;
  gap:1rem;
  align-items:start
}
nav {
  gap:.8rem;
  flex-wrap:wrap;
  justify-content:flex-end;
  font-size:.7rem;
  max-width:15rem
}
.brand {
  font-size:1.45rem
}
.hero,.cabinet .hero,.table .hero {
  grid-template-columns:1fr;
  gap:2.5rem;
  padding-block:3rem
}
.hero-art {
  padding:0
}
.hero-art .image-slot,.cabinet .hero-art .image-slot {
  min-height:25rem
}
.table .hero-copy {
  order:1
}
.table .hero-art {
  order:2
}
.section-heading {
  display:block
}
.section-heading>p {
  margin-top:1rem
}
.collection-section {
  padding-block:3rem
}
.creation-grid,.cabinet .creation-grid,.table .creation-grid {
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:2rem 1rem
}
.creation-card:nth-child(even) {
  margin-top:2rem
}
.creation-card .image-slot,.cabinet .creation-card .image-slot,.table .creation-card .image-slot {
  min-height:15rem;
  padding:1rem
}
.image-slot>strong {
  font-size:1.4rem
}
.card-label h3 {
  font-size:1.1rem
}
.story {
  display:block;
  padding-block:3rem
}
.story h2 {
  margin-block:1rem 2rem
}
.cabinet .story {
  padding:1.5rem
}
.invitation {
  padding-block:3rem 4rem
}
footer {
  align-items:start;
  flex-wrap:wrap
}
.detail {
  grid-template-columns:1fr;
  gap:2.5rem;
  padding-block:2rem 4rem
}
.detail .large {
