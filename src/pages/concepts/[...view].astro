  grid-template-columns:1fr
}

}

@media(prefers-reduced-motion:no-preference) {
  .hero-copy,.detail-copy {
  animation:enter .45s ease both
}
@keyframes enter {
  from {
  opacity:.4;
  transform:translateY(10px)
}
to {
  opacity:1;
  transform:none
}

}

}
@media(prefers-reduced-motion:reduce) {
  :global(html) {
  scroll-behavior:auto
}
.creation-card .image-slot {
  transition:none
}
.creation-card:hover .image-slot {
  transform:none
}

}

</style>
</body></html>
