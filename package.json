{
  "name": "cakeopedia-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "prebuild": "node scripts/pull-catalogue.mjs",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check && tsc -p tsconfig.worker.json",
    "test": "node --test tests/*.test.ts",
    "dev:api": "wrangler dev --config wrangler.local.jsonc --local",
    "db:local": "wrangler d1 migrations apply DB --config wrangler.local.jsonc --local",
    "verify": "npm run check && npm test && npm run build && node --test tests/build.test.mjs tests/production-output.test.mjs",
    "media": "node scripts/build-media.mjs",
    "check:media": "node scripts/check-media.mjs",
    "check:browser": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "astro": "7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@types/node": "24.19.2",
    "miniflare": "4.20260730.0",
    "playwright-core": "^1.65.1",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "wrangler": "4.167.0"
  }
}
